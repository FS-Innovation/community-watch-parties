# ─── Supabase (Database + Auth + Realtime) ───
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Mux (Video Delivery) ───
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# ─── Claude API (AI Matchmaking + Text Analysis) ───
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── RudderStack (Event Tracking / CDP) ───
NEXT_PUBLIC_RUDDERSTACK_WRITE_KEY=your_rudderstack_write_key
NEXT_PUBLIC_RUDDERSTACK_DATA_PLANE_URL=https://your-dataplane.rudderstack.com

# ─── Host Emails ───
HOST_EMAILS=steven@flightstory.com,producer@flightstory.com

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
