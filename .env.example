# ─── Supabase (Database) ───
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Resend (Email) ───
# Get from: https://resend.com → API Keys
RESEND_API_KEY=your_resend_api_key

# ─── Socket.io (Real-time Sync) ───
# URL of your Socket.io server (Railway, Render, etc.)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ─── Daily.co (Live Audio/Video for Stage) ───
# Get from: https://dashboard.daily.co → Developers → API Keys
# Used for host mic broadcasting and audience stage access
DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_DOMAIN=your-domain.daily.co

# ─── Host Emails ───
# Comma-separated list of emails that get host privileges
# Hosts can: play videos, control screen, run Q&As, broadcast mic, invite audience on stage
HOST_EMAILS=steven@doac.com,producer@doac.com

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
